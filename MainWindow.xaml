<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ankieta"
        Height="600"
        Width="1000"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,25,0">

            <!-- WYBÓR PŁCI -->
            

                <StackPanel>
                    <RadioButton x:Name="MezczyznaRadio"
                                 Content="Mężczyzna"
                                 GroupName="Plec"
                                 Margin="5"/>

                    <RadioButton x:Name="KobietaRadio"
                                 Content="Kobieta"
                                 GroupName="Plec"
                                 Margin="5"/>
                </StackPanel>


            <!-- FORMULARZ -->
            

                <StackPanel>

                    <Label Content="Wiek"/>

                    <TextBox x:Name="WiekTextBox"
                             Height="30"
                             Margin="0,0,0,10"/>

                    <Label Content="Kolor"/>

                    <ComboBox x:Name="KolorComboBox"
                              Height="30"
                              SelectedIndex="0"
                              Margin="0,0,0,10">

                        <ComboBoxItem Content="Czerwony"/>
                        <ComboBoxItem Content="Niebieski"/>
                        <ComboBoxItem Content="Zielony"/>
                        <ComboBoxItem Content="Żółty"/>
                        <ComboBoxItem Content="Czarny"/>

                    </ComboBox>

                    <CheckBox x:Name="ZgodaCheckBox"
                              Content="Zgoda"
                              Margin="5,10,0,20"/>

                    <Button Content="Zapisz"
                            Height="40"
                            Click="Zapisz_Click"/>

                </StackPanel>

           

        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="10,0,0,0">

            <TextBlock Text="Wyniki"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Ilość wpisów"
                       FontSize="18"/>

            <TextBox x:Name="IloscWpisowTextBox"
                     Height="40"
                     FontSize="18"
                     IsReadOnly="True"
                     Margin="0,8,0,25"/>

            <TextBlock Text="Najczęstszy kolor"
                       FontSize="30"
                       Margin="0,0,0,15"/>

            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12"
                    Margin="0,0,0,20">

                <TextBlock x:Name="NajczestszyKolorTextBlock"
                           Text="Brak danych"
                           FontSize="22"/>

            </Border>

            <TextBlock Text="Ile M"/>

            <TextBlock x:Name="IloscMTextBlock"
                       Text="0"
                       FontSize="18"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Ile K"/>

            <TextBlock x:Name="IloscKTextBlock"
                       Text="0"
                       FontSize="18"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Ile ZGOD"/>

            <TextBlock x:Name="IloscZgodTextBlock"
                       Text="0"
                       FontSize="18"
                       Margin="0,0,0,10"/>

        </StackPanel>

    </Grid>

</Window>
